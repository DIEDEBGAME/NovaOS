#!/bin/sh
set -e

# Registrar el repositorio oficial de Flathub para el sistema operativo
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# Forzar la actualización de metadatos para que la tienda cargue todas las apps al instante
appstreamcli refresh-cache --force || true
